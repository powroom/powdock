{
  "name": "powdock",
  "version": "0.0.1",
  "description": "A lightweight web UI for the local Docker Engine.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "vite build && bun scripts/precompress.ts",
    "build:npm": "bun run build && bun build server.ts --target bun --minify --outfile start.js && bun scripts/pack-npm.ts",
    "pack:npm": "bun scripts/pack-npm.ts",
    "start": "bun run server.ts",
    "typecheck": "bun check",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@daypicker/react": "^10.0.2",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.38.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.1.18",
    "vite": "^8.0.0"
  }
}
