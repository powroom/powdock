{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "npm-package/**",
    "start.js",
    "node_modules/**",
    "src/routeTree.gen.ts",
    "src/components/ui/**"
  ]
}
